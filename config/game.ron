(
    economy: (
        production_rate: 0.5,
        pop_growth: 0.04,
        min_efficiency: 0.1,
        // 指令控制:每回合最多用各资源库存的 30% 投入建设。
        invest_fraction: 0.3,
        // 住宅目标余量:住宅面积维持在 (人口/生态容量)*1.25。
        housing_buffer: 1.25,
    ),
    combat: (
        war_threshold: -20.0,
        siege_range: 0.25,
        arrival_eps: 0.06,
        // 建筑护甲每回合回修复比例。
        armor_regen: 0.25,
        // 刚殖民建立的新城最多占用定居点总面积的比例。
        colony_footprint: 0.2,
    ),
    diplomacy: (
        // 开火/占领 导致的关系变化（战争期间把关系压到阈值之下）。
        attack_delta: -3.0,
        capture_delta: -25.0,
        // 每回合向「意识形态静息亲和」靠拢的比例（阵营形成/异己升温）。
        drift_rate: 0.02,
        // 已开战且本轮未交战时，向停战线回落的比例（战争疲态 → 战争有始有终）。
        war_fatigue: 0.12,
        // 停战目标关系（高于 war_threshold，故能跨回和平），停火冷却期间关系向它靠拢。
        ceasefire_relation: -6.0,
        // 静息亲和 = affinity_floor + affinity_span * (1 - |Δalignment|/2)。
        // 同阵营 ~ -42+70 = +28（友）；异阵营(Δ=2) ~ -42（敌，最终走向战争）。
        affinity_floor: -42.0,
        affinity_span: 70.0,
        // 每回合随机波动幅度：让关系波动而非单调收敛。
        noise: 1.0,
        // 关系钳位（有界敌意/友好）。
        hostility_floor: -60.0,
        friendship_ceiling: 40.0,
    ),
    market: (
        // 每回合每势力自动兑换的「市场价值」上限（信用点）；0=关闭自动市场。
        auto_trade_limit: 80.0,
        // 关键工业矿物维持的工作缓冲（单位）：低于则用富余矿物兑换补齐。
        working_buffer: 6.0,
        // 兑换价差：卖 (1+spread)× 价值才能买到 1×，抑制无损耗套利。
        spread: 0.15,
    ),
    resources: {
        "water_ice": (name: "水冰", value: 1.0),
        "helium3":   (name: "氦-3", value: 4.0),
        "uranium":   (name: "铀", value: 5.0),
        "thorium":   (name: "钍", value: 4.0),
        "gold":      (name: "金", value: 5.0),
        "platinum":  (name: "铂", value: 6.0),
        "iron":      (name: "铁", value: 1.0),
        "hydrogen":  (name: "氢", value: 0.8),
        "methane":   (name: "甲烷", value: 0.8),
        "carbon":    (name: "碳", value: 1.0),
        "silicon":   (name: "硅", value: 1.2),
    },
    structures: {
        "concrete": (name: "混凝土", armor_per_area: 0.5, cost_mult: 1.0),
        "steel":    (name: "钢结构", armor_per_area: 1.6, cost_mult: 2.2),
    },
    // 舰船 5 级，属性按 spec 的 低/中/高 分档：
    //   护甲 hull:        低≈20-26  中≈24   高≈72
    //   护甲再生 hull_regen(每月回 max 的分数):  低≈0.04  中≈0.08  高≈0.30
    //   速度(月/AU):      低≈0.9    中≈1.2   高≈2.6
    //   伤害 attack:      低≈6      中≈14    高≈48
    //   攻击距离 attack_range:     低≈0.4    中≈0.6   高≈2.4
    //   资源(成本量+稀有度): 常见=铁/碳/硅/氢/甲烷/水冰；稀有=氦-3/钍/铀/金/铂
    //   每级把 spec 的「招牌」数值拉到极高，使每级各有一席之地：
    //   护卫舰=极速游骑；驱逐舰=高再生磨王；巡洋舰=重甲战列；航空母舰=超远程炮台；战列舰=一锤定音。
    ships: {
        "corvette": (
            label: "护卫舰",
            hull: 12.0,          // 低
            hull_regen: 0.04,    // 低
            attack: 6.0,         // 低
            speed: 2.6,          // 高（招牌：极速）
            attack_range: 0.4,   // 低
            build_points: 15.0,
            build_cost: { "iron": 6.0, "carbon": 3.0 },   // 资源：低，常见
            upkeep: 1.5,
        ),
        "destroyer": (
            label: "驱逐舰",
            hull: 24.0,          // 中
            hull_regen: 0.30,    // 高（招牌：超强再生）
            attack: 6.0,         // 低
            speed: 1.2,          // 中
            attack_range: 0.6,   // 中
            build_points: 26.0,
            build_cost: { "iron": 12.0, "carbon": 7.0 },  // 资源：中，常见
            upkeep: 2.5,
        ),
        "cruiser": (
            label: "巡洋舰",
            hull: 72.0,          // 高（招牌：重型装甲）
            hull_regen: 0.08,    // 中
            attack: 14.0,        // 中
            speed: 0.9,          // 低
            attack_range: 0.6,   // 中
            build_points: 44.0,
            build_cost: { "iron": 18.0, "carbon": 10.0, "silicon": 6.0 },  // 资源：高，常见
            upkeep: 6.0,
        ),
        "carrier": (
            label: "航空母舰",
            hull: 20.0,          // 低
            hull_regen: 0.08,    // 中
            attack: 8.0,         // 低
            speed: 0.9,          // 低
            attack_range: 2.4,   // 高（招牌：超远程炮台，敌舰难近身）
            build_points: 58.0,
            build_cost: { "iron": 12.0, "carbon": 8.0, "helium3": 4.0, "platinum": 3.0, "gold": 2.0 },  // 资源：高，稀有
            upkeep: 7.5,
        ),
        "battleship": (
            label: "战列舰",
            hull: 26.0,          // 低（略抬以可抗一轮齐射）
            hull_regen: 0.04,    // 低
            attack: 48.0,        // 高（招牌：一锤定音）
            speed: 1.2,          // 中
            attack_range: 0.6,   // 中
            build_points: 40.0,
            build_cost: { "iron": 10.0, "uranium": 4.0 },  // 资源：低，稀有
            upkeep: 6.5,
        ),
    },
    buildings: {
        "residential": (
            label: "居住区",
            role: "housing",
            construction_speed: 1.0,
            build_cost: { "silicon": 0.3, "iron": 0.2 },
            staff_per_area: 0.0,
            productivity: 1.0,
            default_invest_weight: 1.5,
            default_build_weight: 0.0,
        ),
        "mining": (
            label: "开采区",
            role: "mining",
            construction_speed: 1.0,
            build_cost: { "iron": 0.4 },
            staff_per_area: 4.0,
            productivity: 1.0,
            default_invest_weight: 1.0,
            default_build_weight: 0.0,
        ),
        "construction": (
            label: "建造区",
            role: "shipyard",
            construction_speed: 0.8,
            build_cost: { "iron": 0.4, "carbon": 0.3, "silicon": 0.2 },
            staff_per_area: 6.0,
            productivity: 1.0,
            default_invest_weight: 0.8,
            default_build_weight: 1.0,
        ),
    },
    // 剧情事件表（编年史/叙事弧）。每条的 `trigger` 决定何时火（只火一次），
    // `effects` 是可选的小幅、确定性机械后果（关系/资源）。id 稳定；参与方是可读名。
    // 事件型触发（first_war / first_raze / first_colony / war_between / faction_at_war）
    // 恰好落在对应历史事件发生的那个回合，形成「剧情与局势同步」的叙事弧。
    story: [
        (
            id: "prologue",
            title: "外来的回响",
            body: "无国界科学组织的深空阵列在柯伊伯带之外捕捉到一段规律的引力涟漪——一个重型天体正沿一条极偏心的轨道缓缓内插。行星X崇拜教立即宣称这是「行星X」归来的先兆；科学组织则坚持那只是一颗未编目的大天体。两派就此划下鸿沟。",
            trigger: RoundAt(round: 1),
            participants: ["无国界科学组织", "行星X崇拜教"],
            effects: [Relations(a: 6, b: 8, delta: -2.0), GrantResources(faction: 6, resource: "helium3", amount: 2.0)],
        ),
        (
            id: "solar_max",
            title: "太阳活动峰年",
            body: "太阳活动进入峰年，强烈的日冕抛射让深空信号陷入混沌。各势力临时收紧通讯；深空运输联盟被迫重划所有航线以避开高辐射带，却意外在勘察中发现一片富集的金矿带。",
            trigger: RoundAt(round: 6),
            participants: ["深空运输联盟"],
            effects: [GrantResources(faction: 7, resource: "gold", amount: 4.0)],
        ),
        (
            id: "un_convokes",
            title: "联合国外交大会",
            body: "联合国在月球宁静海基地召集外交大会，呼吁各国就「外来的回响」共享观测数据。美国与欧盟主张联手戒备；中国与俄罗斯则怀疑这是一场以情报为名的渗透。唯有无国界科学组织发布了首批完整数据，赢得中立阵营的赞赏。",
            trigger: RoundAt(round: 12),
            participants: ["联合国", "美国", "欧盟", "中国", "俄罗斯", "无国界科学组织"],
            effects: [Relations(a: 0, b: 6, delta: 3.0), Relations(a: 0, b: 5, delta: 2.0), Relations(a: 0, b: 7, delta: 2.0)],
        ),
        (
            id: "kuiper_boom",
            title: "柯伊伯淘金热",
            body: "星系矿业的高层嗅到了外缘陨石的丰厚回报，宣布启动「柯伊伯淘金热」——数百艘采矿船冲向妊神星、创神星与阋神星的冰封矿带。随即，他们把一船船铂金与铁运回内太阳系，隐约有垄断稀有金属之势。",
            trigger: RoundAt(round: 24),
            participants: ["星系矿业"],
            effects: [GrantResources(faction: 5, resource: "platinum", amount: 3.0), GrantResources(faction: 5, resource: "iron", amount: 8.0)],
        ),
        (
            id: "first_war",
            title: "第一次冲突",
            body: "历史齿轮咬合。两股长期对峙的力量终于越过底线，第一场战争在太阳系爆发——战争不再是谣传，而成了每个势力都必须面对的现实。",
            trigger: FirstWar,
            participants: [],
            effects: [],
        ),
        (
            id: "first_colony",
            title: "拓荒纪元",
            body: "一波殖民浪潮席卷外域。人们不再满足于母星，而是把星图上的每一个空白定居点都当成新的起点——第一个离开母星的殖民地宣告成立，深空从此有了人的足迹。",
            trigger: FirstColony,
            participants: [],
            effects: [],
        ),
        (
            id: "first_raze",
            title: "焚城之痛",
            body: "第一座城市在炮火中被夷为平地。当尘埃落定，人们第一次意识到：战争不仅摧毁舰队，也会把曾经灯火通明的家园从星图上永远抹去。",
            trigger: FirstRaze,
            participants: [],
            effects: [],
        ),
        (
            id: "cult_war",
            title: "异端之怒",
            body: "行星X崇拜教正式与主流势力兵戎相见。教众视战争为「行星X」净化的前奏；常规势力则把这个太阳系边缘的狂热教团视作必须剪除的脓疮——世界骤然多了一个共同的敌人。",
            trigger: FactionAtWar(faction: 8),
            participants: ["行星X崇拜教"],
            effects: [Relations(a: 0, b: 8, delta: -4.0), Relations(a: 2, b: 8, delta: -4.0), Relations(a: 6, b: 8, delta: -4.0)],
        ),
        (
            id: "cn_us_rivalry",
            title: "巨头对峙",
            body: "中国与美国——这颗星球上两支最庞大、最富有的力量——终于正面对撞。地球轨道上空的旗舰遥相对峙，整个太阳系的目光都聚焦在两大巨头之间即将展开的较量。",
            trigger: WarBetween(a: 3, b: 1),
            participants: ["中国", "美国"],
            effects: [Relations(a: 0, b: 3, delta: -2.0), Relations(a: 0, b: 1, delta: -2.0)],
        ),
        (
            id: "northern_watch",
            title: "北方警戒",
            body: "欧盟与俄罗斯的关系跌入冰点。欧洲理事会启动「北方警戒」，将多支舰队前移到波罗的海与高加索方向，并与美国的火星防线相互呼应。",
            trigger: WarBetween(a: 2, b: 4),
            participants: ["欧盟", "俄罗斯"],
            effects: [Relations(a: 2, b: 1, delta: 2.0), Relations(a: 2, b: 4, delta: -3.0)],
        ),
        (
            id: "jupiter_colloquy",
            title: "木星科学会议",
            body: "无国界科学组织在木星轨道空间站召开一场横跨内外的科学会议，公布了对那颗外来天体的轨道精测：它不会撞击任何行星，却会在数十年后掠过大气的边缘。结论尚无定论，但与会各方都感到，某种比战争更根本的东西正在逼近。",
            trigger: RoundAt(round: 36),
            participants: ["无国界科学组织", "联合国", "美国", "欧盟", "中国", "俄罗斯"],
            effects: [Relations(a: 6, b: 8, delta: -3.0), Relations(a: 0, b: 6, delta: 5.0)],
        ),
        (
            id: "planet_x_arrives",
            title: "行星X 现身",
            body: "那颗外来的天体终于越过柯伊伯带、进入内太阳系的视野。无论是崇拜教的欢腾，还是科学组织的冷静测算，所有人都将无法回避一个事实：太阳系，已不再是他们以为的那个太阳系。",
            trigger: RoundAt(round: 60),
            participants: ["无国界科学组织", "行星X崇拜教", "联合国"],
            effects: [],
        ),
    ],
)
