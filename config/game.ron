(
    economy: (
        production_rate: 0.5,
        pop_growth: 0.04,
        min_efficiency: 0.1,
        // 指令控制:每回合最多用各资源库存的 30% 投入建设。
        invest_fraction: 0.3,
        // AI 造舰维护费保留：建新舰前先从库存预留 4× 舰队维护费，只把超出部分用于造舰
        // （把海军养在经济能承受的规模，避免无脑大建→维护费拖垮经济→军备崩盘）。
        upkeep_reserve_mult: 4.0,
        // 住宅目标余量:住宅面积维持在 (人口/生态容量)*1.25。
        housing_buffer: 1.25,
    ),
    combat: (
        war_threshold: -20.0,
        siege_range: 0.25,
        arrival_eps: 0.06,
        // 建筑护甲每回合回修复比例。
        armor_regen: 0.25,
        // 刚殖民建立的新城最多占用定居点总面积的比例。
        colony_footprint: 0.2,
        // 自动指挥舰自保撤退阈值：护甲低于此比例且敌在射程内时后撤修整（拟人的「别送死」）。
        retreat_hull: 0.20,
        // 距首都小于此距离时不撤退（主场驻防/充能，避免「已到家还一直撤退不还手」）。
        retreat_min_dist: 3.0,
        // 模块损毁：每点船体伤害中溢出去损坏组件的比例（0.05=约每 20 点伤害掉一点组件，
        // 军舰随战况渐进丧失武器/护盾，而非满血抗到壳破）。
        component_spill: 0.05,
        // 模块修复：每回合按 0.04 恢复组件完整度；在友方本土/母港内修得更快（与自保撤退
        // 闭环：打残→撤→修→再来）。
        component_repair: 0.04,
        // 护航半径：交战时闲着的 AI 舰在此半径内就近护卫旗舰（航母），保护高价值舰种。
        escort_range: 10.0,
        // 追击半径：AI 舰只在此半径内追敌对舰（不跨全图追远逃的敌舰，避免过度延伸漂移）；
        // 超过则转而轰炸城市/殖民/护卫。
        pursuit_range: 12.0,
        // 舰队防空半径：舰的点防御在 3 AU 内也会替附近友舰拦截导弹（防空屏护，随距离衰减）。
        pd_radius: 3.0,
    ),
    diplomacy: (
        // 开火/占领 导致的关系变化（战争期间把关系压到阈值之下）。
        attack_delta: -3.0,
        capture_delta: -25.0,
        // 每回合向「意识形态静息亲和」靠拢的比例（阵营形成/异己升温）。
        drift_rate: 0.02,
        // 已开战且本轮未交战时，向停战线回落的比例（战争疲态 → 战争有始有终）。
        war_fatigue: 0.12,
        // 停战目标关系（高于 war_threshold，故能跨回和平），停火冷却期间关系向它靠拢。
        ceasefire_relation: -6.0,
        // 记恨（战争疤痕）：一场战争的影响持续多少回合 / 疤痕初值（负=敌意，线性衰减到 0）。
        // 新鲜时 -30 < war_threshold(-20)，所以刚开战的对手**不可能当回合就言和**——这治的是
        // 「开战/停战反复闪烁」；随后地板抬过阈值，和平重新可能（记恨，但会淡）。
        // 这是窗口层（State::notables）唯一的读者。
        war_scar_rounds: 24,
        war_scar_relation: -30.0,
        // 静息亲和 = affinity_floor + affinity_span * (1 - |Δalignment|/2)。
        // 同阵营 ~ -42+70 = +28（友）；异阵营(Δ=2) ~ -42（敌，最终走向战争）。
        affinity_floor: -42.0,
        affinity_span: 70.0,
        // 思潮相似度对静息亲和的对称修正（思潮可变因子，与上方静态 alignment 叠加）：
        // 贡献 = ideology_affinity_span * (2×相似度 − 1)，相似度 ∈ [0,1]（四轴平均 |Δ|/2）。
        // 同思潮=+span，对立=−span，中庸=0。0 = 关闭（只按 alignment 决定）。
        ideology_affinity_span: 16.0,
        // 每回合随机波动幅度：让关系波动而非单调收敛。
        noise: 1.0,
        // 关系钳位（有界敌意/友好）。
        hostility_floor: -60.0,
        friendship_ceiling: 40.0,
    ),
    market: (
        // 每回合每势力**采购**的「市场价值」上限（信用点）；0=关闭市场（谁缺料谁自己扛）。
        auto_trade_limit: 80.0,
        // 买方每资源想维持的库存（单位）——军工目标库存，低于它才会去买。
        working_buffer: 6.0,
        // 市场手续费：买方要交出 cost×(1+spread) 的实物才能换到价值 cost 的货，
        // 差额是市场**烧掉**的价值（sink）——贸易不是免费的价值搬运。
        spread: 0.15,
        // 卖方保留比例：挂单前先留下自己库存的这个比例（1.0=一毛不卖）。
        reserve_fraction: 0.5,
        // 价格发现的「目标覆盖回合数」：世界库存够全世界用几回合算不稀缺。
        // 只够 1 回合 → 顶价；够这么多回合 → 基价。这是「缺某种矿 → 超高价」的旋钮。
        coverage_rounds: 8.0,
        // 稀缺指数：mult = (coverage_rounds/覆盖回合数)^price_alpha。1.0=线性，>1 更陡。
        price_alpha: 1.0,
        // 价格下限（倍率）：严重过剩时最多折到四折。
        price_floor: 0.4,
        // 价格上限（倍率）：断供时最高涨到**八倍**——「超高价」的天花板。
        price_ceiling: 8.0,
        // 「覆盖回合数」下限：库存为 0 时用它代替，免得除零。
        cover_floor: 0.5,
        // 需求滑窗每回合更新比例（0.1 = 用 10% 的本回合消费修正滑窗）。
        demand_smoothing: 0.1,
        // 需求地板（单位/回合）：低于它视为「几乎没人消费」，价格回到基价
        // （否则没人用的矿会因为库存 0 被永久顶在天价）。
        demand_min: 0.05,
        // 友好门槛：关系达到此值算友好，享折扣。
        friendly_relation: 15.0,
        // 友好折扣上限（0.15 = 最多打 85 折买对方的货）。
        friendly_price_discount: 0.15,
        // 敌对加价上限（1.5 = 关系冷到交战边缘时，买对方的货要付 2.5 倍价）：
        // 关系直接变成**成本**——同一个矿，向敌人买贵得多。
        hostile_price_markup: 1.5,
        // **全面禁运**阈值：关系 ≤ 此值即「根本不卖给你」（所有资源）。
        // 比交战阈值(-20)更早生效：还没开打，供货就已经断了。
        embargo_relation: -14.0,
        // **运费率**：每 1 AU 距离、按货值计的运费（0.02 = 30 AU 加价 60%）。
        // 货物不是瞬移的——深空的货真的更贵。
        freight_per_au: 0.02,
        // **穿越引力异常带的运费倍率**：按「浸入异常带的深度」再加这么多倍。
        // 没有掌握 MOND 的势力只能花大价钱走这条线。
        mond_freight_mult: 3.0,
        // **异常区丢货率**：非 master 的货每浸入异常带 1 AU 损失这么多货值
        // （确定性比例，不是掷骰——掷骰会污染 Prng 流、破坏同种子复现）。
        mond_loss_per_au: 0.01,
        // 丢货率上限（整批货最多损失到这个比例）。
        mond_loss_cap: 0.5,
        // 异常带运费中**付给承运人**（掌握 MOND 的 master）的比例：只有它能可靠穿越，
        // 于是它天然成为柯伊伯带的垄断承运人、对这条线上的贸易抽税；其余部分被烧掉。
        carrier_share: 1.0,
    ),
    // 光速治理：以「距离首都」为代价的行政管理与忠诚度。这给超大帝国一个自然上限，
    // 让游戏在上千回合后仍是多方参与，而不是收敛成少数几个永久霸权。一座城离统治
    // 势力首都越远，管理费越高、忠诚度越低；治理不到位（欠费）时忠诚度暴跌，爆发
    // 离心叛乱，城市被夷平为空白。
    governance: (
        // 每座城每回合的治理开销基数（市场价值/回合）。
        admin_base: 0.2,
        // 治理开销随距离（超过 admin_range 的部分，AU）递增的系数。
        admin_per_au: 0.04,
        // 治理「可达」半径（AU）：该半径内没有距离带来的额外开销。
        admin_range: 6.0,
        // 治理到位时，忠诚度每回合向距离目标恢复的比例。
        loyalty_recover: 0.06,
        // 治理不到位时，忠诚度每回合的下降量（乘欠费比例）。
        loyalty_penalty: 0.25,
        // 忠诚度距离目标随距离（超过 loyalty_range 的部分）递减的系数：
        // 目标忠诚 = clamp(1 - loyalty_distance * a, 0, 1)。超过约 21.6 AU 的
        // 殖民地目标忠诚已低于叛变阈值——即使治理到位也会最终离心叛乱。
        loyalty_distance: 0.045,
        // 忠诚度不受距离影响的半径（AU）。
        loyalty_range: 6.0,
        // 忠诚度低于此值即爆发「离心叛乱」，城市被夷平为空白。
        loyalty_revolt: 0.30,
        // 治理容量：势力总人口超过此值即超载，管理能力被人口分散（与距离叠加）。
        population_capacity: 4000.0,
        // AI 默认每座城每回合投入的娱乐/福利预算（市场价值/回合），用于提升忠诚度。
        default_entertainment: 1.0,
        // 娱乐投入换算：投入该市场价值使忠诚度目标 +1.0（entertainment_bonus = paid/cost）。
        entertainment_cost: 20.0,
        // 迁都（自动控制）评估周期：AI 每 12 回合重新评估一次首都选址；0=关闭自动迁都，
        // 首都只在「亡城」时被强迁到人口最高的活城。带 mode=Player 的首都不会被覆盖。
        capital_review_every: 12,
        // 迁都须达到的「总治理距离成本」最小改善量（AU）：候选首都必须比当前首都低至少
        // 这么多么才值得迁（避免反复横跳/无意义微调）。
        capital_relocate_threshold: 1.0,
        // 首都「人口占比」的全国忠诚度 buff：首都人口占全势力活城人口的比例 × 此系数 =
        // 每座城的目标忠诚加成。首都=人口中心 → 全国向心力更强。
        capital_share_loyalty_buff: 0.2,
        // 迁都的全国忠诚度代价：旧首都人口占比 × 此系数 = 每座城的忠诚下降（迁离大都会
        // 更动荡）。与 buff 互为反制，让迁都是为了省治理成本、却要以全国忠诚为赌注。
        capital_share_relocate_cost: 0.5,
    ),
    // MOND / 柯伊伯引力异常：距太阳超过 radius 的深空进入「异常区」，真实引力偏离
    // 标准牛顿假定。没有掌握 MOND 修正引力的势力（除 masters 之外的所有势力）在
    // 异常区内轨道计算错误，指令坐标与实际到达坐标产生偏移——舰难以精确轰炸/殖民/
    // 停靠深处目标。这让 cult 偏僻的柯伊伯带圣所成为天然堡垒：围攻者在那里「迷航」。
    //
    // **偏移是伪随机的、不是写死的**：每回合一次新尝试（由 势力×舰名×回合 确定性派生，
    // 不消费主 Prng 流），所以**任何深度都有成功几率**——MOND 再强也只是让你多试几个
    // 回合，而不是永远进不去。实测（1000 回合的真实尝试序列）：
    //   海王星/冥王星/卡戎（30 AU 内）p=1.00 一次到位
    //   伊克西翁（圣所，深 2.17）   p=0.92 首命中第 1 回合
    //   妊神星（深 7.01）           p=0.29 首命中第 3 回合
    //   创神星/阋神星（深 ≈10）      p=0.20 首命中第 8 回合
    mond: (
        // 异常区起始半径（距太阳，AU）。
        radius: 28.0,
        // 非 master 势力在异常区内，每超出 radius 1 AU 的**最大**导航偏移量（AU）。
        // 实际偏移是伪随机的（见下方 drift_shape），所以这是上界而非定值。
        drift_per_au: 0.03,
        // 伪随机偏移的分布形状：`偏移 = 上界 × roll^drift_shape`（roll 均匀 ∈ [0,1)）。
        // 单次成功率 p = P(偏移 ≤ arrival_eps)：
        //   1.0（均匀）→ 伊克西翁 0.92 / 妊神星 0.29 / 创神星 0.20；
        //   0.5        → 偏移偏向大值，创神星掉到 0.04（≈26 回合才蒙对一次）——但永不为 0。
        // 这是「带内到底有多难」的总旋钮：调小 = 圣所与柯伊伯矿更难被外人碰到。
        drift_shape: 1.0,
        // 掌握了 MOND 修正引力的势力（在异常区内无导航偏移）。
        masters: ["行星X崇拜教"],
    ),
    // 合纵连横 / 均势外交：当某势力的综合实力占比（城市数 + 舰队质量加权）达到
    // hegemon_power 时被判定为「霸权」，其余较弱势力被共同威胁推向彼此——弱者相互
    // 结盟（向 coalition_affinity 靠拢），弱者对霸权疏远/敌意（向 hegemon_affinity
    // 靠拢）。霸权对任一弱者开战则触发集体安全（其他弱者对霸权关系骤降）。这给
    // 「一家独大」一个众矢之的：军事联手制衡 + 经济多国资源封锁，使上千回合后的世界
    // 维持多方参与，而非收敛成少数永久霸权。全部确定性、数据驱动。
    balance: (
        // 霸权判定阈值：综合实力占比达到此值即被定为「霸权」并引发弱者反制。
        hegemon_power: 0.30,
        // 综合实力权重：城市数（领土/经济基础）与舰队质量（舰艇引擎数值）。
        power_city_weight: 1.0,
        power_fleet_weight: 1.0,
        // 弱者-弱者关系向此值靠拢（联盟目标亲和，彼此友好/结盟）。
        coalition_affinity: 15.0,
        // 弱者-弱者向联盟靠拢的每回合比例。
        coalition_rate: 0.06,
        // 「遏制」目标亲和：弱者对霸权的关系被下压到接近、但通常仍在交战阈值之上
        // （-20）——它们不 «无脑宣战»，而是疏远/提防霸权（冷战式遏制 + 经济封锁）。
        // 真正的共同军事行动留给「集体安全」：霸权一旦开打某弱者，其余弱者群起而攻之。
        hegemon_affinity: -18.0,
        // 弱者对霸权下压的每回合比例。
        hegemon_rate: 0.08,
        // 集体安全：霸权对任一弱者开战时，其余弱者对霸权的关系骤降幅度（触发共同防御）。
        collective_defense_delta: -12.0,
        // 联盟至少需几个成员（不含霸权）才成立。
        min_members: 2,
        // 弱国「倒向联盟」的疏远阈值：对霸权关系 ≤ 此值即视为已加入反制联盟。
        // **这就是经济封锁的判据**：已倒向联盟的弱者 ↔ 被锁定的霸权之间**全面禁运**
        // （所有资源都不卖），不再只是「少卖一点」。
        coalition_estrange: -10.0,
        // 经济制裁的「治理代价」：被封锁的霸权维持帝国（行政+娱乐）的成本倍率（>1 =
        // 被孤立的大国要花更多资源养边地，远端殖民地更易离心叛乱→体量自然回落）。
        sanction_cost_mult: 1.45,
    ),
    // 自动控制（Auto）的**执行者**：`Auto` 这一档承诺「系统每回合决定并改写」，这一节就是
    // 「谁去写」的两个执行者的参数——
    //   ① 风格三轴（temper / lone_wolf / kiting）的**逐舰重估**（`autocontrol::style`）；
    //   ② 设计图的**建图 / 重估 / 回收**（`autocontrol::blueprints`）。
    // 全部走派生骰子（势力×舰名/舰级×回合×用途），不消费主 Prng 流；重估是**概率**触发、
    // 步长也是**分布**（指数松弛）——风格是慢变量，每回合大改只会把轨迹噪声化。
    autocontrol: (
        // --- ① 风格轴逐舰重估 ---------------------------------------------------
        // 每回合、每舰、每轴被重估的概率（0 = 关掉风格执行者，退回旧的「值冻结」行为）。
        style_chance: 0.35,
        // 单次重估最多走完「当前值 → 战况目标」这段距离的比例（实际步长 = roll × 它）。
        style_step_max: 0.55,
        // 变化小于它就当没变（不写叶）：控制面 diff 是给人读的，抖 0.001 只是噪声。
        style_epsilon: 0.01,
        // 战况 → temper（理智↔热血）：在打(+)、打赢(+) 促成热血；被打残(−)、撤退多(−)
        // 促成理智（欺软怕硬 = 先吃弱的）。四个数一起决定这条轴被什么驱动。
        temper_war: 0.6,
        temper_win: 0.8,
        temper_damage: 1.4,
        temper_withdraw: 0.7,
        // 编队规模参考值：半径内友舰数达到它时 lone_wolf 目标 ≈ 0（<它 → 独狼，>它 → 护航）。
        lone_wolf_ref: 2.0,
        // 编队规模的观察半径（AU）；0 = 用 combat.escort_range（护航机制自己的半径）。
        lone_wolf_radius: 0.0,
        // kiting（风筝↔贴脸）的三个权重：敌我火力比、自身硬度对比、自己挨了多少打。
        kiting_power: 0.8,
        kiting_hardness: 0.5,
        kiting_hurt: 1.0,
        // --- ② 设计图（AI 建图 / 重估 / 回收）------------------------------------
        // 每回合、每个「归 AI 管的建造区」被重新生成一次设计的概率（抽签）。
        blueprint_chance: 0.25,
        // 每回合、每个 (势力, 舰级) 重抽一次**设计意图**（主题）的概率。主题是图的名字，
        // 所以必须比选装更黏：改主题 = 换一张图（旧图没人指向就被回收）。
        blueprint_intent_chance: 0.08,
        // 画图时的**库存余量**：图只挑「库存折成 1/(1+余量) 之后仍买得起」的模块。
        // 图在回合步进里画、船在下一回合出厂时才付钱，不留余量就会白送模块（commit_spend
        // 钳零），而白送的模块照样付维护费——实测会把舰队推过「养不起→锈蚀→拆队」的悬崖。
        // 0 = 不留余量（与出厂现算同一条线）。
        blueprint_stock_margin: 0.0,
        // 回收「没有建造区指向、且不是玩家钉的」自建图（长局里图库不该只增不减）。
        blueprint_reap: true,
        // 设计主题表：意图 → 选装偏好（各分类评分权重 + 造价惩罚）。
        // 「买不起就不装」那条硬规则照旧生效 ⇒ 任何主题都不会造出势力供不起的舰。
        blueprint_themes: [
            // 强袭：堆武器，战时更可能抽到（在打仗的势力自然造出火力型设计）。
            (name: "强袭", weight: 1.0, war_weight: 1.6,
             cat_weapon: 1.0, cat_defense: 1.0, cat_thrust: 1.0, cat_utility: 1.0,
             cost_penalty: 0.0),
            // 堡垒：堆防御（护盾/装甲/点防），挨得住消耗战。
            (name: "堡垒", weight: 0.8, war_weight: 0.8,
             cat_weapon: 1.0, cat_defense: 1.0, cat_thrust: 1.0, cat_utility: 1.0,
             cost_penalty: 0.0),
            // 远洋：堆推进（速度=规避与抢先战位），和平期的机动作战型。
            (name: "远洋", weight: 0.7, war_weight: 0.3,
             cat_weapon: 1.0, cat_defense: 1.0, cat_thrust: 1.0, cat_utility: 1.0,
             cost_penalty: 0.0),
            // 平价：不挑分类，狠狠惩罚贵模块 —— 资源紧张时的量产型。
            (name: "平价", weight: 0.8, war_weight: 0.0,
             cat_weapon: 1.0, cat_defense: 1.0, cat_thrust: 1.0, cat_utility: 1.0,
             cost_penalty: 0.0),
        ],
    ),
    // 历史层的容量（判据见 Salience：分层按「后续计算需要访问哪一段历史」）。
    //   milestones = 需要**无限过去**的那一层，随 checkpoint 存活（当前为空——没有任何
    //                variant 有无限过去的读者，见 State::milestones 的文档）。
    //   notables   = 需要**一定窗口**的那一层，只保留最近 notable_window 个回合。
    //               当前唯一成员是战争（WarStarted/WarEnded），读者是「记恨地板」。
    // 0 = 不设上限 / 不裁剪（无损优先）；里程碑层设了上限则最旧的先丢，丢弃量记在
    // State::milestones.dropped / dropped_through_round 里——截断可见，不静默。
    // 窗口层被裁掉是**预期行为**，不是损失，所以不记 dropped。
    history: (
        max_milestones: 0,
        notable_window: 24,
    ),
    // 思潮（可变化意识形态）：4 条轴逐回合按「变化因素」向信号 target 靠拢。
    // 变化因素：和平↔军国=战争得失；科学↔技术=飞船在 MOND 区 vs 开采 MOND 区资源；
    // 人民↔精英=经济好坏；自然↔殖民=人均面积高低。数值为换算系数，可按长局观测调。
    ideology: (
        drift_rate: 0.05,
        military_scale: 0.5,
        mond_scale: 0.4,
        economy_scale: 25.0,
        area_ref: 0.15,
        area_scale: 8.0,
        // 思潮优势端的自平衡 debuff：处于优势端思潮（军国/科学/精英/殖民）的势力，按其在
        // 星系中的体量（活城人口占比，单极化坐大）被扣全国忠诚度；并叠乘该势力「思潮≠行为」
        // 的连续不符度。全平滑、无硬阈值断点。
        debuff: (
            // 单势力总忠诚度惩罚上限（0..1，每回合从忠诚目标扣的最大比例）。
            max_loyalty_penalty: 0.20,
            // 体量斜坡下/上界：该势力活城人口占全星系比例低于 gate_lo=全不起效，达 gate_hi=全量。
            gate_lo: 0.06,
            gate_hi: 0.30,
            // 战争强度斜坡带宽：与敌关系越低于交战阈值越贴近「在打仗」。
            war_band: 10.0,
            // 军事占比平滑中枢：低于此 → 「低军事」不符度趋近 1。
            mil_share_ref: 0.30,
            // 各轴惩罚权重（0..1）。
            w_military: 1.0,
            w_science: 1.0,
            w_elite: 1.0,
            w_colony: 1.0,
        ),
    ),
    resources: {
        "水冰": (name: "水冰", value: 1.0),
        "氦-3":   (name: "氦-3", value: 4.0),
        "铀":   (name: "铀", value: 5.0),
        "钍":   (name: "钍", value: 4.0),
        "金":      (name: "金", value: 5.0),
        "铂":  (name: "铂", value: 6.0),
        "铁":      (name: "铁", value: 1.0),
        "氢":  (name: "氢", value: 0.8),
        "甲烷":   (name: "甲烷", value: 0.8),
        "碳":    (name: "碳", value: 1.0),
        "硅":   (name: "硅", value: 1.2),
    },
    structures: {
        "concrete": (name: "混凝土", armor_per_area: 0.5, cost_mult: 1.0),
        "steel":    (name: "钢结构", armor_per_area: 1.6, cost_mult: 2.2),
    },
    // 天体/行星**类型**表——视觉与类型元数据（纯展示）。每个 `state` 天体只存一个
    // 类型 key（`Body::kind`），本表由前端经 `/api/meta` 读出渲染（three.js/着色器）。
    // 引擎模拟从不读它：它只是「星系长什么样」的数据化。class 是前端选 shader 的分支：
    //   rock(陨石/岩石) / terran(类地宜居) / venus(浓厚大气) / martian(红色荒漠) /
    //   lunar(灰岩卫星) / gas(气态巨行星,可 banded) / ice(冰封,可 banded) /
    //   titan(雾霾卫星) / dwarf(柯伊伯矮行星)。
    // radius 是相对类地行星(1.0)的显示尺寸；banded=横向色带；emissive=自发光 0..1；
    // atmosphere=边缘光/大气辉光色；roughness/metalness 为材质参数。星环是 intrinsic
    // body 属性(见 `Body::ring`，土星/天王星有)，不属于类型。
    body_kinds: {
        "terran":    (label: "类地行星", class: "terran",   color: "#2a6cc8", accent: "#bcd6e8", atmosphere: "#7db7e8", radius: 1.00, banded: false, emissive: 0.06, roughness: 0.75, metalness: 0.0),
        "venusian":  (label: "浓厚大气", class: "venus",    color: "#e6c07a", accent: "#c98a3f", atmosphere: "#f2d9a0", radius: 0.95, banded: false, emissive: 0.04, roughness: 0.90, metalness: 0.0),
        "martian":   (label: "红色荒漠", class: "martian",  color: "#c1440e", accent: "#7c3526", atmosphere: "#e08a5f", radius: 0.85, banded: false, emissive: 0.02, roughness: 0.90, metalness: 0.05),
        "rocky":     (label: "岩石行星", class: "rock",     color: "#a8977f", accent: "#6d5f4e", atmosphere: "#141210", radius: 0.55, banded: false, emissive: 0.0,  roughness: 1.00, metalness: 0.10),
        "lunar":     (label: "灰岩卫星", class: "lunar",    color: "#c8c8d2", accent: "#9d9da8", atmosphere: "#101014", radius: 0.40, banded: false, emissive: 0.0,  roughness: 1.00, metalness: 0.0),
        "gas_giant": (label: "气态巨行星", class: "gas",    color: "#d8b18c", accent: "#a97a52", atmosphere: "#f0d9b0", radius: 2.60, banded: true,  emissive: 0.02, roughness: 0.85, metalness: 0.0),
        "ice_giant": (label: "冰巨星",   class: "ice",     color: "#7cc4e8", accent: "#2f6aa0", atmosphere: "#a8d8f0", radius: 1.80, banded: true,  emissive: 0.0,  roughness: 0.60, metalness: 0.05),
        "ice_world": (label: "冰封卫星", class: "ice",     color: "#e8f4ff", accent: "#b7d6ea", atmosphere: "#cfe8ff", radius: 0.55, banded: false, emissive: 0.0,  roughness: 0.50, metalness: 0.05),
        "titan":     (label: "雾霾卫星", class: "titan",   color: "#e0a15e", accent: "#b87840", atmosphere: "#f0c080", radius: 0.60, banded: false, emissive: 0.03, roughness: 0.85, metalness: 0.0),
        "dwarf":     (label: "矮行星",   class: "dwarf",   color: "#d6cdb8", accent: "#8f8571", atmosphere: "#9a8f7a", radius: 0.35, banded: false, emissive: 0.0,  roughness: 1.00, metalness: 0.0),
    },
    // 舰船 5 级。舰级属性分三类：
    //   (1) 平台直接属性：船体 hull、船体再生 hull_regen —— 模块**不能**改它们（船体是
    //       本体的直接值）；另有槽位/造价/维护费。
    //   (2) 平台修正系数：armor_mult(护甲硬度) / shield_mult(护盾) /
    //       shield_regen_mult(护盾再生) / speed_mult(速度上限) / accel_mult(加速度) /
    //       attack_mult(伤害) / range_mult(攻击距离) / pd_mult(点防御)，分别缩放所搭载的
    //       对应模块输出。舰级身份由此体现（护卫=快、驱逐=再生、巡洋=重甲、航母=超远程、
    //       战列=一锤定音）。
    //   (3) 舱容 cargo：**与战斗无关的第三类能力**——一次能装多少单位货（运输）。
    //       它**不从 hull 推**：船体大 ≠ 能装（航母 20 才是唯一的散货船）。有效舱容
    //       还要乘战损折算 hull/hull_max（受伤的运输舰装得少，见 `model::cargo_capacity`）。
    //   (4) 出厂角色 default_freighter（第三条风格轴，与行为风格/风筝姿态同形的**控制属性**）：
    //       true = 自动控制把它当**运输舰**（排集货路线），false = 当**战舰**（找仗打）。
    //       缺省 false（= 旧行为：每艘舰都是战舰）；**只有航母是 true**。它只管「自动控制
    //       给它派哪种活」，**不解除武装**——运输舰照样自动开火、照样按 kiting 软移动。
    // 速度 / 加速度 / 攻击距离**没有舰级基础值**：它们完全来自推进/武器模块，所以
    // 「推进」和「武器」一样是必须的（没有推进模块就没有速度/攻击距离=0）。
    // 分档（直接属性）：hull 低≈12-26 高≈72；hull_regen 低≈0.04 高≈0.30。
    // 修正系数分档：低≈0.9，中≈1.0，高≈1.3-1.5，极高≈1.8-2.0。
    ships: {
        "corvette": (
            label: "护卫舰",
            hull: 12.0,          // 低（直接船体）
            hull_regen: 0.04,    // 低（直接再生）
            build_points: 15.0,
            build_cost: { "铁": 6.0, "碳": 3.0 },   // 资源：极低，常见
            upkeep: 1.5,
            slots: 2,            // 至少「武器+推进」两个槽（轻装哨戒）
            cargo: 2.0,          // 舱容：极低（哨戒不是运输舰）
            armor_mult: 0.9,     // 低
            shield_mult: 0.9,    // 低
            shield_regen_mult: 0.9, // 低
            speed_mult: 1.0,     // 中（哨戒：不追求飙速，而是高速加速机动）
            accel_mult: 1.8,     // 招牌：极高加速度 → 抢位/盘旋（哨戒甩敌）
            attack_mult: 0.9,    // 低
            range_mult: 0.9,     // 低
            pd_mult: 1.4,        // 招牌：点防御修正高 → 拦导弹的哨戒
        ),
        "destroyer": (
            label: "驱逐舰",
            hull: 24.0,          // 中（直接船体）
            hull_regen: 0.30,    // 高（直接再生，招牌：超强再生）
            build_points: 26.0,
            build_cost: { "铁": 12.0, "碳": 7.0 },  // 资源：中，常见
            upkeep: 2.5,
            slots: 2,
            cargo: 4.0,          // 舱容：低（远洋部署：跑得远，但装得不多）
            armor_mult: 1.0,     // 中
            shield_mult: 0.9,    // 低
            shield_regen_mult: 1.0, // 中（远洋部署：不靠盾，靠船体再生）
            speed_mult: 1.3,     // 招牌：远洋部署 → 高速度巡航
            accel_mult: 1.0,     // 中
            attack_mult: 0.9,    // 低
            range_mult: 1.0,     // 中
            pd_mult: 1.0,        // 中
        ),
        "cruiser": (
            label: "巡洋舰",
            hull: 72.0,          // 高（直接船体，招牌：重型装甲）
            hull_regen: 0.04,    // 低
            build_points: 44.0,
            build_cost: { "铁": 18.0, "碳": 10.0, "硅": 6.0 },  // 资源：极高，常见
            upkeep: 6.0,
            slots: 3,            // 中型舰：火力+防护+推进
            cargo: 6.0,          // 舱容：中（重甲舰体，顺带能拉货）
            armor_mult: 1.5,     // 高（重甲 → 护甲硬度放大）
            shield_mult: 1.3,    // 高
            shield_regen_mult: 1.3, // 高（招牌：扛伤害，盾再生快）
            speed_mult: 1.0,     // 中
            accel_mult: 0.8,     // 低
            attack_mult: 1.2,    // 中
            range_mult: 1.0,     // 中
            pd_mult: 0.9,        // 低
        ),
        "carrier": (
            label: "航空母舰",
            hull: 20.0,          // 低
            hull_regen: 0.04,    // 低
            build_points: 58.0,
            build_cost: { "铁": 12.0, "碳": 8.0, "氦-3": 4.0, "铂": 3.0, "金": 2.0 },  // 资源：高，稀有
            upkeep: 7.5,
            slots: 3,
            cargo: 20.0,         // 招牌：唯一的散货船——机库本来就是它的本体，装 20（=5 艘驱逐）
            default_freighter: true,   // 出厂角色 = **运输舰**（唯一一个）：舰级身份 = 它天生该干的活
            armor_mult: 0.9,     // 低
            shield_mult: 0.9,    // 低
            shield_regen_mult: 0.9, // 低
            speed_mult: 1.0,     // 中
            accel_mult: 1.0,     // 中
            attack_mult: 0.9,    // 低（单发不强，但射程极远）
            range_mult: 1.8,     // 招牌：极高射程 → 远程放风筝
            pd_mult: 0.9,        // 低
        ),
        "battleship": (
            label: "战列舰",
            hull: 30.0,          // 中（玻璃大炮：能抗一轮齐射即可）
            hull_regen: 0.04,    // 低
            build_points: 40.0,
            build_cost: { "铁": 10.0, "铀": 4.0 },  // 资源：中，稀有
            upkeep: 6.5,
            slots: 3,            // 主力舰三槽：火力+盾点防+推进
            cargo: 6.0,          // 舱容：中（玻璃大炮：弹药库改不成货舱，但也拉得动）
            armor_mult: 0.9,     // 低
            shield_mult: 0.9,    // 低
            shield_regen_mult: 0.9, // 低
            speed_mult: 0.9,     // 低
            accel_mult: 0.8,     // 低
            attack_mult: 2.0,    // 招牌：极高伤害 → 一锤定音（玻璃大炮）
            range_mult: 1.3,     // 高
            pd_mult: 1.4,        // 招牌：点防御修正高 → 玻璃大炮自保拦导弹
        ),
    },
    // 舰船定制组件（飞船定制化 ↔ 资源优势）——把「多稀缺资源」换成「不一样的作战
    // 打法」，而不是把面板数字拉高。每件武器有**伤害类型**（kinetic/plasma/missile）、
    // 交战距离、追踪力、对盾/对甲倍率；防御有**护盾池**（优先吸收、可再生）、额外
    // 装甲、点防御（拦导弹）。选装谁决定你怎么打：铀→磁轨/重炮拆甲；金铂→护盾+等
    // 离子；氦-3/氢→高速导弹袭扰。这就是资源优势→真实战斗力，全程确定性、无 RNG。
    components: {
        // --- 武器（伤害类型 × 防御 的取舍） ------------------------------------
        "kinetic": (
            label: "磁轨炮",
            category: "weapon",
            damage: 4.0,
            damage_type: "kinetic",
            range: 0.4,
            tracking: 2.0,
            shield_mult: 0.6,
            hull_mult: 1.0,
            shield: 0.0, shield_regen: 0.0, hardness: 0.0, intercept: 0.0,
            fire_rate: 1.0, fire_spread: 0.0,
            speed: 0.0, hull_regen: 0.0, upkeep: 0.6,
            cost: { "铁": 4.0, "碳": 2.0 },   // 常见矿：入门火力（拆甲）
        ),
        "plasma": (
            label: "等离子炮",
            category: "weapon",
            damage: 8.0,
            damage_type: "plasma",
            range: 0.9,
            tracking: 1.6,
            shield_mult: 1.5,
            hull_mult: 0.85,
            shield: 0.0, shield_regen: 0.0, hardness: 0.0, intercept: 0.0,
            fire_rate: 1.0, fire_spread: 0.0,
            speed: 0.0, hull_regen: 0.0, upkeep: 1.4,
            cost: { "氦-3": 3.0, "金": 1.5 }, // 稀有：对盾强、射程远
        ),
        "railgun": (
            label: "电磁轨道炮",
            category: "weapon",
            damage: 14.0,
            damage_type: "kinetic",
            range: 1.2,
            tracking: 2.6,
            shield_mult: 0.7,
            hull_mult: 1.3,
            shield: 0.0, shield_regen: 0.0, hardness: 0.0, intercept: 0.0,
            fire_rate: 1.0, fire_spread: 0.0,
            speed: 0.0, hull_regen: 0.0, upkeep: 2.2,
            cost: { "铀": 3.0, "铁": 2.0 }, // 稀有：远程拆甲重炮
        ),
        "missile": (
            label: "集束导弹",
            category: "weapon",
            damage: 9.0,
            damage_type: "missile",
            range: 2.4,
            tracking: 3.0,   // 制导：高速目标难规避，但会被点防御拦截
            shield_mult: 1.0,
            hull_mult: 1.2,
            shield: 0.0, shield_regen: 0.0, hardness: 0.0, intercept: 0.0,
            fire_rate: 1.0, fire_spread: 0.0,
            speed: 0.0, hull_regen: 0.0, upkeep: 1.6,
            cost: { "氢": 3.0, "碳": 2.0 }, // 超远射程，吃氢
        ),
        // --- 防御（护盾池 / 装甲 / 点防御） ------------------------------------
        "shield": (
            label: "能量护盾",
            category: "defense",
            damage: 0.0, damage_type: "", range: 0.0, tracking: 0.0,
            shield_mult: 1.0, hull_mult: 1.0,
            shield: 12.0, shield_regen: 0.15, hardness: 0.0, intercept: 0.0,
            speed: 0.0, hull_regen: 0.0, upkeep: 2.0,
            cost: { "铂": 2.0, "氦-3": 1.0 }, // 铂金级护盾（吸收池）
        ),
        "armor": (
            label: "装甲夹层",
            category: "defense",
            damage: 0.0, damage_type: "", range: 0.0, tracking: 0.0,
            shield_mult: 1.0, hull_mult: 1.0,
            shield: 0.0, shield_regen: 0.0, hardness: 10.0, intercept: 0.0,
            speed: 0.0, accel: 0.0, hull_regen: 0.0, upkeep: 0.9,
            cost: { "铁": 5.0, "碳": 3.0 },    // 常见：让船体变硬（反比例减伤）
        ),
        "composite": (
