    //   速度(月/AU):      低≈0.9    中≈1.2   高≈1.6
    //   伤害 attack:      低≈5      中≈12    高≈24
    //   攻击距离 attack_range:     低≈0.4    中≈0.6   高≈0.9-1.0
    //   资源(成本量+稀有度): 常见=铁/碳/硅/氢/甲烷/水冰；稀有=氦-3/钍/铀/金/铂
    ships: {
        "corvette": (
            label: "护卫舰",
            hull: 12.0,          // 低
