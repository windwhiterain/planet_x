(
    economy: (
        production_rate: 0.5,
        pop_growth: 0.04,
        min_efficiency: 0.1,
        // 指令控制:每回合最多用各资源库存的 30% 投入建设。
        invest_fraction: 0.3,
        // 住宅目标余量:住宅面积维持在 (人口/生态容量)*1.25。
        housing_buffer: 1.25,
    ),
    combat: (
        war_threshold: -20.0,
        siege_range: 0.25,
        arrival_eps: 0.06,
        // 建筑护甲每回合回修复比例。
        armor_regen: 0.25,
        // 刚殖民建立的新城最多占用定居点总面积的比例。
        colony_footprint: 0.2,
    ),
    diplomacy: (
        attack_delta: -3.0,
        capture_delta: -25.0,
        relax_rate: 0.5,
    ),
    resources: {
        "water_ice": (name: "水冰"),
