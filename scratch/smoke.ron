arget:"总统",damage:2.498823529411765),(type:"attack",attacker:"落基",target:"镇岳",damage:2.9263118183160888),(type:"revolt",city:"创神星采矿站",faction:"星系矿业"),(type:"resurgence",faction:"星系矿业",body:"创神星",ship:"富矿"),(type:"war_started",a:"俄罗斯",b:"行星X崇拜教"),(type:"war_started",a:"欧盟",b:"行星X崇拜教"),(type:"war_ended",a:"俄罗斯",b:"美国"),(type:"war_ended",a:"深空运输联盟",b:"行星X崇拜教"),(type:"war_ended",a:"美国",b:"行星X崇拜教"),(type:"story",id:"un_convokes",title:"联合国外交大会",participants:["联合国","美国","欧盟","中国","俄罗斯","无国界科学组织"])],chronicle:[(round:1,id:"prologue",title:"外来的回响",body:"无国界科学组织的深空阵列在柯伊伯带之外捕捉到一段规律的引力涟漪——一个重型天体正沿一条极偏心的轨道缓缓内插。行星X崇拜教立即宣称这是「行星X」归来的先兆；科学组织则坚持那只是一颗未编目的大天体。两派就此划下鸿沟。",participants:["无国界科学组织","行星X崇拜教"]),(round:5,id:"first_war",title:"第一次冲突",body:"历史齿轮咬合。两股长期对峙的力量终于越过底线，第一场战争在太阳系爆发——战争不再是谣传，而成了每个势力都必须面对的现实。",participants:["无国界科学组织","行星X崇拜教"]),(round:5,id:"cult_war",title:"异端之怒",body:"行星X崇拜教正式与主流势力兵戎相见。教众视战争为「行星X」净化的前奏；常规势力则把这个太阳系边缘的狂热教团视作必须剪除的脓疮——世界骤然多了一个共同的敌人。",participants:["行星X崇拜教","无国界科学组织"]),(round:6,id:"solar_max",title:"太阳活动峰年",body:"太阳活动进入峰年，强烈的日冕抛射让深空信号陷入混沌。各势力临时收紧通讯；深空运输联盟被迫重划所有航线以避开高辐射带，却意外在勘察中发现一片富集的金矿带。",participants:["深空运输联盟"]),(round:7,id:"first_colony",title:"拓荒纪元",body:"一波殖民浪潮席卷外域。人们不再满足于母星，而是把星图上的每一个空白定居点都当成新的起点——第一个离开母星的殖民地宣告成立，深空从此有了人的足迹。",participants:["美国","木星"]),(round:8,id:"cn_us_rivalry",title:"巨头对峙",body:"中国与美国——这颗星球上两支最庞大、最富有的力量——终于正面对撞。地球轨道上空的旗舰遥相对峙，整个太阳系的目光都聚焦在两大巨头之间即将展开的较量。",participants:["中国","美国"]),(round:12,id:"un_convokes",title:"联合国外交大会",body:"联合国在月球宁静海基地召集外交大会，呼吁各国就「外来的回响」共享观测数据。美国与欧盟主张联手戒备；中国与俄罗斯则怀疑这是一场以情报为名的渗透。唯有无国界科学组织发布了首批完整数据，赢得中立阵营的赞赏。",participants:["联合国","美国","欧盟","中国","俄罗斯","无国界科学组织"])],ship_name_seq:{"中国":8,"俄罗斯":3,"无国界科学组织":3,"星系矿业":5,"欧盟":3,"深空运输联盟":3,"美国":3,"联合国":4,"行星X崇拜教":6}),pre:(flow:(city_production:{},faction_production:{},upkeep:{},governance:{}),metrics:(cities:19,ships:19,fleet_value:512.0691280042774,population:9173,power_share:{"中国":0.20526315789473684,"俄罗斯":0.20116959064327483,"无国界科学组织":0.03742690058479532,"星系矿业":0.026315789