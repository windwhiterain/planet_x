# 这一份单态化实例的**声明**（`px_graphs/src/bin/mono-gen.rs` 读它）。
#
# ⚠ 它与 stage 1 同目录、同主名：`fields.rs` ↔ `fields.mono`。
# 生成器只吃 stage 1 的 `.rs` 路径，其余全部从它推出来 —— 于是 stage 1 可以在任何位置。
#
# key = value 文本，不是 Rust 模块：它要被两个宿主读（图脚本只读 `id`、生成器要全部），
# 做成模块就得为两边凑出都能编译的形状。见笔记 §166.1。

# 生成物的库名：装载目录里必须有它、且**每份实例唯一**（同名会互相覆盖）。
# ⚠ 默认是 `px_mono_<stage 1 的主名>`，这一条可以省（这里写出来只为说明）。
lib = px_mono_clouds

# 这一份实例的算子 id。⚠ **每份唯一**：`Context::find` 取的是「已装载库里第一个命中的
# op_id」，而装载顺序是路径字典序 ⇒ 同 id 时两份实例会互相抢，而它们的语义并不相同。
id = clouds.volume.cloud.coarse.closed

# 只在**接口**变了（描述符的 inputs、参数字段）时才升。改场函数**不需要**动它 ——
# `SOURCE_HASH` 由生成器按内容算，自己会变。
version = 1

# 身份要覆盖的共享依赖（stage 1 与 stage 2 的模板由生成器自动收进去，这里只列两侧的契约）。
# ⚠ 漏一份就会「改了它而身份没变」⇒ 缓存静默给旧产物（§28.2 那条病的同一个形状）。
ingredient = px_cook/src/field_fn.rs
ingredient = px_volume_op/src/lib.rs
ingredient = px_verify/src/cloud_field.rs
ingredient = px_verify/src/noise.rs
ingredient = px_verify/src/proxy.rs
ingredient = px_volume_schema/src/volume.rs
ingredient = px_volume_schema/src/params.rs
ingredient = px_volume_schema/src/payload.rs
ingredient = px_field_schema/src/field.rs
