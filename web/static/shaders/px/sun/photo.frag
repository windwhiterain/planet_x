#ifndef PX_SUN_SUN_PHOTO_FRAG
#define PX_SUN_SUN_PHOTO_FRAG
#include <px/noise/perlin.glsl>
#include <px/noise/warpT.glsl>

  precision highp float;

  uniform float uTime;
  uniform float uIntensity;
  varying vec3 vObjPos;
  varying vec3 vWorldPos;
  varying vec3 vNormal;

  // --- 配色：**线性 HDR 锚点**，不是「看着调」出来的 ---------------------------
  // 参考图（SDO/AIA 304Å）上那几档橙，隔着 `ACES + exposure + sRGB` 三跳看，直接照着屏幕
  // 调 HDR 会一直调歪：ACES 在 0.7 以上压得极扁、而且红通道先饱和，于是「再亮一点」的结果
  // 是**丢掉颜色和结构**（实测：日面 (254,238,220)，p10..p90 只有 238..243 —— 一块白饼）。
  //
  // 下面六个常量是 `node scripts/shots/run.mjs --solve <屏幕rgb>` **反解**出来的
  // （ACES 的逆，见 scripts/shots/grade.mjs）。锚点取自两张参考图上量到的分位数
  // （`scratch/ref/measure*.mjs`），所以「配色」这一步只剩审美，亮度一调颜色不会跟着跑。
  //   C_VOID  ← 屏幕 (112,26,2)   暗纹最深处
  //   C_HOLE  ← 屏幕 (152,42,3)   暗纹（参考图 p5 ≈ (130,32,3)、p25 ≈ (159,45,8)）
  //   C_MID   ← 屏幕 (192,62,8)   典型日面（p50 ≈ (190,60,0)）
  //   C_ACT   ← 屏幕 (232,124,22) 活动区（p75 ≈ (218,100,4)）
  //   C_CORE  ← 屏幕 (251,196,74) 亮核（p95 ≈ (245,191,21)）
  //   C_WHITE ← 屏幕 (255,240,180) 白热核（p99 ≈ (254,228,143)）—— **加色**用，不进 ramp
  // ⚠ 上一版锚点（(28,5,2)…(252,180,80)）的问题不是"暗"而是**两端都不够**：
  //   实测旧渲染盘面 p10..p90 只有 21..146，而参考图是 51..190 —— 中间像"均匀的脏橙"，
  //   没有"深处很暗、核里白热"的那种**内发光的层次**。观感上的"不够亮"一半来自这里。
  const vec3 C_VOID = vec3(0.2143, 0.0339, 0.0017);
  const vec3 C_HOLE = vec3(0.3494, 0.0526, 0.0014);
  const vec3 C_MID  = vec3(0.5627, 0.0756, 0.0026);
  const vec3 C_ACT  = vec3(0.9954, 0.1732, 0.0026);
  const vec3 C_CORE = vec3(1.7926, 0.4452, 0.0063);
  const vec3 C_WHITE = vec3(5.5311, 2.1099, 0.1016);

  // 色球亮边（临边那一圈「光从里面顶出来」的亮带）。HDR > 1 ⇒ 会被 bloom 抓成辉光，
  // 所以日缘的亮不是画上去的橙边，而是**真的比白更亮**的光溢出来。
  const vec3 C_RIM = vec3(3.0815, 0.8223, 0.0205);   // ← 屏幕 (255,215,110)

  vec3 heatColor(float h){
    h = clamp(h, 0.0, 1.0);
    vec3 c = mix(C_VOID, C_HOLE, smoothstep(0.06, 0.28, h));
    c = mix(c, C_MID,  smoothstep(0.26, 0.56, h));
    c = mix(c, C_ACT,  smoothstep(0.54, 0.80, h));
    return mix(c, C_CORE, smoothstep(0.78, 1.00, h));
  }

  void main(){
    vec3 p = normalize(vObjPos);
    vec3 n = normalize(vNormal);
    vec3 viewDir = normalize(cameraPosition - vWorldPos);
    float mu = clamp(dot(n, viewDir), 0.0, 1.0);
    float t = uTime;

    // ⓪ **域扰动（distortion）**：结构场在采样之前先被一个低频位移场推一下。
    // 参考图里那些暗区/活动区**没有一块是圆的** —— 边界全是扭的、带须的（磁流管的形状）。
    // 直接用 fbm 阈值得到的只会是圆头圆脑的斑块，怎么调频率都不像。
    // 位移量有硬约束：`amt · warpK ≲ 0.3`（推导见 px/noise/warp.glsl，超了映射会反折、
    // 出现带尖点的折痕）。这里 0.50 × 0.55 = 0.275，留了余量。
    // ⚠ 位移场的频率要**落在盘面上**才有"扭"的效果：warpK 太小时位移在整个日面上几乎是常数，
    // 那只是把噪声整体平移了一下（等于换了个随机种子），看起来完全没有扰动。
    vec3 pw = warpT(p, 0.50, 0.55, t * 0.04, 1.0);

    // ① 米粒组织：**丝状体（fibril）**。两件事同时做：
    //    (a) `1-ridged` 给出"亮格 + 暗沟"的网状（304Å 的日面是这种「苔藓/地毯」质感，
    //        而不是可见光那种圆滚滚的米粒）；
    //    (b) 米粒场**自己也被一个中频位移场拖动** ⇒ 亮暗纹从"斑点"变成**卷曲的丝**。
    //        参考图 4× 放大后满盘都是这种弯的须状纹，而上一版只有圆头的斑块。
    //    ⚠ 位移场的频率必须**比米粒低一档但只低一档**（这里 SC*0.10 ≈ 11，即约 10 个米粒
    //    跨一个位移特征）：太高 → 只是把米粒打散成噪声；太低（用 ⓪ 的 pw）→ 位移在一个
    //    米粒尺度上几乎是常数，等于整体平移，纹路还是直的。
    float SC = 96.0;
    vec3 fw = vec3(
      fbmP(p * SC * 0.10 + vec3(0.0, 0.0, t * 0.05)),
      fbmP(p * SC * 0.10 + vec3(11.0, 5.0, t * 0.05)),
      fbmP(p * SC * 0.10 + vec3(3.0, 19.0, t * 0.05)));
    vec3 pg = p * SC + (fw - 0.5) * 1.7;
    float ph = 0.5 + 0.5 * sin(t * 0.55);
    float g1 = 1.0 - ridgedP(pg + vec3(0.0, 0.0, t * 0.35));
    float g2 = 1.0 - ridgedP(pg + vec3(37.0, 11.0, t * 0.35 + 41.0));
    // ⚠ 窗口比上一版更陡（0.12→0.74）：暗沟要**细而深**。参考图的暗纹是细丝，
    // 软窗口会把丝糊成"云絮"（上一版放大后就是这个毛病）。
    float gran = smoothstep(0.16, 0.66, mix(g1, g2, ph));
    // ② 超米粒：更大尺度的对流胞，给米粒组织一个「群」的结构（约 10 倍于米粒）。
    //    权重压到 0.22：它是**低频软斑**，占太多会把细密的丝状体糊掉。
    float superG = smoothstep(0.32, 0.72, fbmP(pw * 9.0 + vec3(0.0, 0.0, t * 0.06)));
    float mott = gran * 0.78 + superG * 0.22;

    // ③ 大尺度：暗条通道 + 活动区 + 亮核。
    //    ⚠ 暗条频率从 2.7 抬到 **5.2**：2.7 那版圈出来的是一块块"大陆"（读起来是"熔岩行星"
    //    而不是"恒星表面"）。参考图的暗区是**细长的通道/丝状体**，不是大陆。
    float hole = smoothstep(0.47, 0.59, fbmP(pw * 8.5 + vec3(5.0, 9.0, t * 0.02)));
    //    极区额外压暗：参考图上半盘就是一大片暗区（但只压到 50%，别压成黑）。
    hole = max(hole, 0.40 * smoothstep(0.62, 0.98, abs(p.y)));
    // 活动区：高频、小而亮。第一版取了 4.2 的低频 ⇒ 亮斑有半个日面那么大，
    // 读起来是「大陆与海洋」的行星地图，不是恒星表面的活动区。
    // `ridgedP` 典型值只有 ~0.25（Σa·n²，n 平均 0.5），阈值必须比 value 版低一截。
    float act = smoothstep(0.50, 0.88, ridgedP(pw * 7.5 + vec3(21.0, 3.0, t * 0.03)));
    // **亮核**：比 `act` 低一档频率的稀疏脊 ⇒ 日面上只有两三个"从里往外爆"的热核，
    // 参考图的盘心就是这个东西（一圈一圈的亮臂）。没有它，日面的亮是"均匀地亮"，
    // 没有"光从内迸发"的方向感。
    float core = smoothstep(0.52, 0.90, ridgedP(pw * 2.6 + vec3(9.0, 17.0, t * 0.02)));

    // ④ 合成。地板/天花板按参考图的分位数定：p50 ≈ C_MID、p95 ≈ C_CORE。
    //    跨度刻意做**大**（±0.30）：两张参考图的共同点是 p5..p95 拉得很开（51…190），
    //    中间调被压扁的那种"均匀脏橙"正是上一版读起来发闷的原因。
    float heat = 0.38 + (mott - 0.5) * 0.72
               - 0.38 * hole
               + 0.32 * act
               + 0.18 * core;
    heat = clamp(heat, 0.0, 1.0);

    vec3 col = heatColor(heat);

    // ⑤ **白热核**（加色，不参与 ramp）：参考图 p99 ≈ (254,228,143)，比 ramp 的顶还亮一截，
    //    而且只占 ~1% 的面积。加色而不是抬 ramp，是因为它要**只出现在脊线上**
    //    （ramp 是全局映射，抬顶会把整片日面都拉白）。HDR 峰值 ~2.5 ⇒ bloom 之后
    //    就是参考图里那种"从核里爆出来的光"。
    float burst = smoothstep(0.68, 0.94, ridgedP(pw * 6.4 + vec3(31.0, 7.0, t * 0.02)));
    col += C_WHITE * (0.50 * burst * burst);
    // **热核的光晕**：亮核周围一圈**加色**的暖光（不只是把颜色映射到顶上）。
    // 参考图里那些"从里往外爆"的核，特征是中心白热、外面裹一层橙黄、再外面才回落到日面色 ——
    // 单靠 ramp 只能改颜色、不能"往外发光"，所以要单独加一层。
    col += C_WHITE * (0.09 * core * core) + vec3(0.90, 0.20, 0.008) * (0.16 * core);

    // ⑥ 临边：**304Å 是临边增亮**（色球在切向的路径更长 ⇒ 日缘一圈更亮），
    //    和可见光的临边昏暗正好相反。SDO 参考图实测：盘心 lum 69 → 0.75R 105 → 日缘 149，
    //    即**盘心是盘面上最暗的地方**，一路亮到边。
    //    ⚠ 上一版是 `1.00 + 0.55(1-mu)^3.5` —— 盘心 1.0、日缘 1.55，而且全挤在最外圈；
    //    实测出来盘心比日缘还亮（118 vs 109），完全反了。
    //    ⚠ 除的是 **0.816**（= 盘面上的面积加权平均，∫ 的权重是 2r·dr，E[mu]=2/3）
    //    而不是 1.0：这样"整个盘面的平均电平"仍然等于锚点电平，ACES 的饱和度才不会跑。
    //    拿盘心或日缘去归一都会让锚点只在那一圈准（ACES 的饱和度随电平变）。
    float limb = (1.0 - 0.36 * pow(mu, 1.7)) / 0.816;
    col *= limb;

    // ⑦ **色球亮边**：日缘那一圈"光从球里面顶出来"的亮。它是一条**加色**的亮带
    //    （不是把盘面乘亮）：`(1-mu)^5` 把所有能量压在最外 ~13% 的半径里。
    //    HDR 峰值 > 1.5 ⇒ 交给 bloom 变成辉光，溢到黑空里的那层光晕也是它。
    float rim = pow(1.0 - mu, 5.0);
    col += C_RIM * (0.55 * rim);

    gl_FragColor = vec4(col * uIntensity, 1.0);
  }
#endif // PX_SUN_SUN_PHOTO_FRAG
