    if (t1 <= t0) discard;

    // æ­¥é¿ç±ãè¿æ¡å°çº¿ç©¿è¿ä½ç§¯çé¿åº¦ãå³å® â ä¸è®ºæ å°è¿æ¯æ­£ç©¿é½ä¿è¯è¦çï¼ä¸ä¼æ¼éæ ·ã
    float dt = (t1 - t0) / float(max(uSteps, 1));
    float t = uTime;
    vec3 acc = vec3(0.0);
    // â  **ä¸è¦èªå¸æ¶é¡¹**ãè¿éæ¾ç»æä¸ä¸ª `trans *= exp(-a*0.5)`ï¼å½åççç±æ¯ãåå¾è´´è¾¹
    // ç³æä¸çãï¼ï¼ä»£ä»·æ¯æä¸ä¸ª**åå­¦èçåå°ä½**åæäº**æé¥±å**çï¼å¯åº¦ä¸æ¶¨ trans å°±è¡°å
    // å¾æ´å¿«ï¼**ç´¯ç§¯éè¢«é³æ­»** ââ äºæ¯æ uChromo ä» 26 è°å° 60ï¼æ¥ç¼çå¼ä¸ä¸ªæ°é½æ²¡å
    // ï¼ä¸¤ä¾§é½æ¯ 114/113ï¼ãç¨æ·é£å¥ãè¿æ¯ä¸ªé»è¾é®é¢ï¼ä½ æ¹æ°å¼æ¯æ²¡æç¨çãè¯´çå°±æ¯å®ã
    // æ¥å/è²çé½æ¯åå­¦èçï¼ç´¯å å°±è¯¥æ¯ Î£ colÂ·densityÂ·dtï¼æ²¡æéå°çè¿ä¸é¡¹ã
    // èµ·ç¹æåä¸ªæ­¥é¿ï¼åºå®æ­¥é¿ä¼å¨çé¢ä¸çä¸åå¿åå±ï¼æä¸ä¸å°±æ²¡æäºã
    float tt = t0 + dt * 0.5;
    for (int i = 0; i < uSteps; i++) {
      if (tt > t1) break;
      vec3 p = ro + rd * tt;
      float rr = length(p) / uSunR;
      float d = coronaDensity(p, rr, t);
      if (d > 0.0) {
        // é¢è²æ²¿åå¾èµ°ä¸æ®µï¼rrâ1 æ¯**è²ç**ï¼æ·±çº¢ï¼â æç½ï¼K æ¥åï¼â èç½ï¼å¤åï¼ã
        // æ·±çº¢é£ä¸æ®µååç±ä¸å±ç¬ç«ççå£³æä¾ï¼ç°å¨ç±å¯åº¦åºèªå·±å¸¦åºæ¥ã
        vec3 col = mix(vec3(1.25, 0.20, 0.05), vec3(1.15, 0.90, 0.62),
                       smoothstep(1.7, 2.8, rr));
        col = mix(col, vec3(0.48, 0.56, 0.95), smoothstep(1.8, 3.2, rr));
        acc += col * d * dt;
      }
      tt += dt;
