  // å°çº¿ Ã çãçå¿å¨ä¸çåç¹ ââ å¤ªé³å°±å¨åç¹ï¼è¡æçè²å¨é lightDir ä¹æ¯è¿ä¹åè®¾çï¼ã
  vec2 hitSphere(vec3 ro, vec3 rd, float R){
    float b = dot(ro, rd);
    float c = dot(ro, ro) - R * R;
    float h = b * b - c;
    if (h < 0.0) return vec2(-1.0, -1.0);
    h = sqrt(h);
    return vec2(-b - h, -b + h);
  }

  // å¯åº¦åº ââ **æ¥ç¥**ï¼ä¸æ¯ä¸å¢æã
