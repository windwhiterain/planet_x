  // åååæ§åªå£°åæ²¡ææ¹ååå¥½ï¼ä¸¤èç¸ä¹åªä¼å¾å°ãçé¢ä¸ååçæé©³ããç¨æ·çåè¯æ¯
  // ãå¤ªé³çå¤§æ°å¤ªè¿ç´äºï¼å¼å¾åæ¥ç¥ä¸ç¹ãã
  //
  // æ¥ç¥æ¯**æ²¿ç£åçº¿**çç»æï¼è´´æ¥é¢ä¸åéç¶ä½æ£®æï¼spiculesï¼ï¼å¾å¤æ¯å¼§ï¼loops/arcadeï¼ï¼
  // å±åç¹å¾æ¯**æ²¿å¾åæé¿**ãå½¼æ­¤ä¹é´æ**çç©ºé**ãæä»¥è¿éåä¸ä»¶äºï¼
  //   â  **ååå¼æ§éæ ·**ï¼æåªå£°åæ å¨å¾ååç¼©ï¼kR < kTï¼â ç»æèªç¶æ²¿å¾åæé¿æä¸/å¼§
  //   â¡ **è¶³ç¹è°å¶**ï¼ä¸å±ä½é¢æå¼§å¸¦åæãä¸æ ¹æ ¹ãï¼èä¸æ¯ãä¸åååã
  //   â¢ **åååªå**ï¼æ¶é´æ¼åèµ°ååï¼å·®å¨èªè½¬ï¼â ç»æä¼æ­å¨ï¼èä¸æ¯æ´å¢å¹³ç§»
  // å±±èé¡¹ä»ç±**åä¸æ¬¡** fbm æåºæ¥ï¼å¤è·ä¸éåªå£°ç­äºæ ALU ç¿»åï¼æ²¡å¿è¦ï¼ã
  float coronaDensity(vec3 p, float rr, float t){
    // â  `max(rr, 1.0)` **ä¸è½ç**ãå°çº¿ç©¿è¿**æ¥é¢åé¨**æ¶ rr < 1 â åå¼ `rr^-uFalloff` ä¼çç¸ï¼
    // ææ° 2.6 æ¶ rr=0.25 æ 36ï¼çä¸åºé®é¢ï¼ï¼ææ° 9 æ¶åä¸ä¸ªç¹æ¯ **262144** â æ¥é¢åé¨çéæ ·
    // æç´¯ç§¯å¼æå°å¤©ä¸ â **æ´ä¸ªç»é¢ç§æçº¯ç½**ï¼ä¸è° sunIntensity / æå / bloom **å¨é½åä¸ä½**
    // ï¼è²è°æ å°ä¹åå®å°±å·²ç»æ¯å¤©ææ°å­ï¼ãæ¥åå¨åç**åé¨**æ¬æ¥å°±æ²¡æå¯åº¦ï¼å¤¹å° rr â¥ 1
    // æ¢æ­¢ä½çç¸ãåæ´åç©çã
    float fall = pow(max(1.0 / max(rr, 1.0), 0.0), uFalloff);
    if (fall < 2.0e-3) return 0.0;                  // ä¾¿å®çåç®ï¼å¤å°å°±å«è¿åªå£°

    // å±é¨æ­£äº¤åºï¼u = å¾åï¼t1/t2 = ååãååå¼æ§éæ ·å¿é¡»å¨**è¿ä¸ª**åºéå ââ
    // ç´æ¥å¯¹ p ä¹ä¸åç³»æ°æ¯åä¸å°ãæå¾åæä¼¸ãçï¼é£åªæ¯ååå¼æ§ç¼©æ¾ä¸çè½´ï¼ã
    vec3 u = p / max(length(p), 1e-4);
    vec3 ref = abs(u.y) > 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 t1 = normalize(cross(u, ref));
    vec3 t2 = cross(u, t1);
    float pr = dot(p, u) / uSunR;                   // å¾ååæ ï¼æ¥åå¾ä¸ºåä½ï¼
    float pa = dot(p, t1) / uSunR;                  // åååæ 
    float pb = dot(p, t2) / uSunR;
    // å¾åé¢çä½ãååé¢çé« â æ²¿å¾åæé¿çº¦ 3 å
    vec3 q = u * (pr * 0.55) + t1 * (pa * 1.7) + t2 * (pb * 1.7);

    // â¢ åååªåï¼æååç¸ä½éåå¾ä¸æ¶é´éå¼ â å¼§ä¼ä¸å±å±éå¨ï¼å·®å¨èªè½¬çè§æï¼
    float shear = t * 0.03 + pr * 0.35;
    float n = fbm(q * 2.6 + vec3(shear, -t * 0.05, -t * 0.04));
    float ridge = 1.0 - abs(2.0 * n - 1.0);
    // â  ä¸ï¼ä½å¼åº**ççåå° 0**ï¼ä¸ä¹é´ææçç©ºéï¼å¹³æ»è¿æ¸¡ä¼ç³æç°é¾ï¼
    float filament = smoothstep(0.38, 0.86, n) * (0.22 + 1.35 * smoothstep(0.26, 0.90, ridge));
    // â¡ è¶³ç¹ï¼ä½é¢åæä¸ææï¼åä¸åæ ååä¸å± vnoise æ¿ãæä¸æä¹é´çç©ºã
    float fp = vnoise(vec3(pa * 0.9, pb * 0.9, pr * 1.6) + vec3(t * 0.015, 0.0, 5.7));
