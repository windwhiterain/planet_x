  // NOTE: 色球/日珥已经**不在这个着色器里**了 —— 它们是世界空间的插片几何
  //（`prom.vert` / `prom.frag`，见 sun.js 的 buildPromCards）。三轮试错的结论见
  // `.agents/notes/sun-prominence.md`：体积积分在掠射视角把针平均成雾，解析求交是 2.5D。
  // 这里只剩下**日冕体**（一层很淡的广域辉光）。

  void main(){
    vec3 ro = cameraPosition;
    vec3 rd = normalize(vWorld - ro);

    vec2 to = hitSphere(ro, rd, uOuter);
    if (to.y <= 0.0) discard;                       // è¿æ¡å°çº¿æ ¹æ¬ä¸ç¢°ä½ç§¯
    float t0 = max(to.x, 0.0);
    float t1 = to.y;

    // --- â  å¨**åºæ¯æ·±åº¦**å¤å¤¹æ­ï¼ä½ç§¯æ¸²æçæ­£ç¡®æ§å³é®ï¼---------------------------
    // ç¨æ·çåè¯ï¼ãraymarching å¿é¡»å¨æ·±åº¦åé¢åä¸æ¥ããä¸å¤¹æ­çè¯ï¼é®æ¡ç©**èå**çä»è´¨
    // ä¹ä¼è¢«ç´¯å è¿æ¥ ââ ç°è±¡å°±æ¯æ¥åç³å¨è¡æçèåé¢ä¸ã
    //
    // â  è¿ä¸æ­¥**ä¸è½**å¨åºæ¯é£ä¸è¶éåï¼æ¥åæ¸²æè¿çé£ä¸ª framebufferï¼æ·±åº¦éä»¶å°±æ¯è¦éç
    // çº¹çï¼**åä¸ framebuffer çéä»¶ä¸è½åæ¶è¢«éæ ·**ï¼åé¦ç¯ï¼ãæä»¥æ·±åº¦æ¥èª postfx ç
    // **æ·±åº¦é¢è¶**ï¼å¦ä¸å¼ çº¹çï¼ã
    //
    // æ³¨æè¿ä¸ä¹åé£ä¸ªãå¨åçè¡¨é¢æªæ­ãçåæ³**ä¸æ¯ä¸åäº**ï¼é£æ¯å¨ä¸ä¸ª**åºå®åå¾**ä¸åï¼
    // äºæ¯ b = R å¤è·¯å¾é¿åº¦çªéä¸å â é¶è· â é»å¸¦ãè¿éæ¯åå¨**çå®çé®æ¡é¢**ä¸ï¼
    // ä½ç½®éåºæ¯è¿ç»­åå ââ æä»¥å®æ¢æ­£ç¡®ãåä¸ä¼é åºç¡¬è¾¹ã
    float tScene = 1e30;   // åºæ¯æ·±åº¦ï¼æ²¿å°çº¿çè·ç¦»ï¼ï¼æ²¡ææ·±åº¦å¾æ¶ç­äºæ ç©·è¿
    if (uHasDepth > 0.5) {
      float dz = texture(uDepth, gl_FragCoord.xy / uResolution).x;
      // çªå£æ·±åº¦ â æ²¿**è§çº¿æ¹å**çè·ç¦»ï¼æ­£å¼ï¼ãâ  è¿ä¸ªå¼å­çè¾åºæ¯æ­£è·ç¦»ï¼**ä¸æ¯**è´çè§ç©ºé´ zã
      // æç¬¬ä¸æ¬¡å°±æ ½å¨è¿å¿ï¼æ¿å®å»é¤ä¸ä¸ªè´ç dirView.z â tScene åè´ â t1 < t0 â **æ¯ä¸ªçå
      // é½è¢« discard** â æ¥åæ´ä¸ªæ¶å¤±ï¼ç¨æ·ä¸ç¼çåºãæ ¹æ¬æ²¡ææ¥ææ¥ç¥ãï¼ã
      float n = uNearFar.x, f = uNearFar.y;
      float viewDist = (2.0 * n * f) / (f + n - (2.0 * dz - 1.0) * (f - n));
      // è§ç©ºé´å°çº¿æ¹åï¼world æ¹åç¨ viewMatrix è½¬è¿å»ï¼çåéæ viewMatrixï¼
      vec3 dirView = (viewMatrix * vec4(rd, 0.0)).xyz;
      // æ²¿å°çº¿çè·ç¦» = è§è½´ä¸çè·ç¦» / æ¹åä¸è§è½´å¤¹è§çä½å¼¦ = viewDist / (âdirView.z)
      float tScene2 = viewDist / max(-dirView.z, 1e-6);
      tScene = tScene2;
