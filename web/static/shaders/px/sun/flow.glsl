#ifndef PX_SUN_FLOW_GLSL
#define PX_SUN_FLOW_GLSL
#include <px/noise/perlin.glsl>

  // 世界空间的**日珥场**（`prom.vert` 与 `prom.frag` 共用）。
  //
  // ⚠ **说清楚"共享噪声空间"指的是什么**（第一版我理解错了，记在这里免得再错）：
  //   共享的是**带子的扭曲** —— 带子的朝向、以及它沿长度往哪边扭，都取自同一个平缓的
  //   世界空间三维场。所以相邻带子朝同一侧倒、往同一侧扭（**成片**），
  //   而场本身在球面上缓慢转 ⇒ 不同区域不一样。用户原话：
  //   *「带子的群面形态太均匀，连朝向都是一样的，要以一定的平缓的噪声分布，world space 噪声，
  //     带子和带子之间要在同一个噪声空间」*。
  //   **带子内部的纹理**（那些细小的日珥）**不是**世界空间的，而是**每条带子自己的本地空间**
  //   （沿带宽/带长的 uv + 每片的 seed）—— 见 `prom.frag` 顶部。把内部纹理也做成世界空间是错的：
  //   那样纹理的尺度被钉死在"世界单位"，一条窄带子里就只剩两三根丝，而且和带子本身没有关系。
  //
  // ⚠ 频率必须**平缓**：这里 k=0.42 ⇒ 特征尺度 ≈ 2.4 世界单位 ≈ 0.37 太阳半径。
  //    频率一高，"相关"就退化成"各随各的噪声"，和 random 没有区别。

  // 平缓的三维矢量场（未归一化；模长本身也是信息 —— 模长大的地方"磁流更强"，
  // 带子倒得更狠、更长）。三个分量用同一频率、不同偏移，保证是同一个场。
  vec3 promFlow(vec3 p, float t){
    vec3 q = p * 0.42 + vec3(0.0, 0.0, t * 0.010);
    return vec3(
      fbmP(q),
      fbmP(q + vec3(13.7, 4.1, 7.3)),
      fbmP(q + vec3(2.9, 27.3, 8.9))) - 0.5;
  }

  // 把场 `F` 投到以 `n` 为法线的切平面里 ⇒ "这条带子朝哪边倒"的单位方向。
  // 模长退化时退回 `fallback`（球面上总会有几处 `F ∥ n`，不退就会出 NaN 的顶点）。
  vec3 promTangential(vec3 n, vec3 F, vec3 fallback){
    vec3 f = F - n * dot(F, n);
    float l = length(f);
    return l > 1e-4 ? f / l : fallback;
  }

  // 「哪里有日珥」：同一族的又一个平缓标量场。日珥不是均匀铺在日面上的，而是**成片**的
  // （活动区/网络边界）。用它当**长度/不透明度的乘子** ⇒ 大片是空白、大片是密林，
  // 而不是"满球一层均匀的毛"。频率比 promFlow 更低（0.30）⇒ 片更大。
  float promMask(vec3 p, float t){
    vec3 q = p * 0.30 + vec3(41.0, 17.0, t * 0.004);
    return smoothstep(0.38, 0.58, fbmP(q));
  }
#endif // PX_SUN_FLOW_GLSL
