#ifndef PX_NOISE_ROT_GLSL
#define PX_NOISE_ROT_GLSL
  // 「八度之间换格子朝向」用的**正交旋转矩阵**（绕 (0.30,0.70,0.6481) 转 47°）。
  //
  // 为什么需要它：`vnoise` 是三线性插值的**格点**噪声，等值线自带轴向方格。fbm/ridged 把
  // 几个八度叠起来时所有格子的朝向完全相同 ⇒ 叠出来的不是分形而是**一张方格纸**
  // （现象：太阳米粒放大后是一片小方块；行星地表与云层上同样存在，只是尺度更小）。
  // 每进一个八度转 47°，各八度朝向互不相同，叠起来才各向同性。代价只有一次 3×3 乘法。
  //
  // 单独一个文件而不是写进 fbm.glsl：photo.frag 这类着色器**同时** include fbm 和 ridged，
  // 常量写在两边就是重复定义（GLSL 直接报错）。守卫版本号化，两边各 include 一次即可。
  const mat3 PX_NOISE_ROT = mat3(
    0.710618, 0.540760, -0.450112,
    -0.407204, 0.837814, 0.363665,
    0.573766, -0.075139, 0.815565);
#endif // PX_NOISE_ROT_GLSL
