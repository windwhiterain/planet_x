    "default_doctrine": { "label": "舰队默认风格", "editor": "doctrine" },
    "default_kiting": { "label": "舰队默认风筝姿态", "editor": "kiting" },
    "default_role": { "label": "舰队默认角色", "editor": "role" },
    "ship_orders": { "label": "指令", "editor": "behavior", "key_label": "ship" },
    "ship_doctrine": { "label": "风格", "editor": "doctrine", "key_label": "ship", "follows": "default_doctrine" },
    "ship_kiting": { "label": "风筝姿态", "editor": "kiting", "key_label": "ship", "follows": "default_kiting" },
    "ship_role": { "label": "角色", "editor": "role", "key_label": "ship", "follows": "default_role" },
    "investment_budget": { "label": "投资预算/回合", "editor": "number", "key_label": "resource", "key_label_from": "config.resources", "keys_from": { "path": "config.resources", "key": "@key" }, "hint": "每回合拨给「建楼」的资源量；没写就是这一层没表态（沿链上溯）" },
    "construction_budget": { "label": "建造预算/回合", "editor": "number", "key_label": "resource", "key_label_from": "config.resources", "keys_from": { "path": "config.resources", "key": "@key" }, "hint": "每回合拨给「造舰」的资源量" },
    "loyalty_budget": { "label": "娱乐/福利预算", "editor": "number", "key_label": "city", "keys_from": { "path": "@state.cities[*]", "where": "势力=${势力}", "key": "城名" }, "hint": "按城建：给这座城拨多少娱乐/福利资源（忠诚目标里的娱乐项）" },
    "invest_weights": { "label": "建设权重", "editor": "number", "key_label": "building" },
    "build_weights": { "label": "建造权重", "editor": "number", "key_label": "building" },
    "blueprints": { "label": "设计图", "editor": "blueprint", "key_label": "name",
      "read_only": { "ship_count": "本图造过", "launch_waiting": "买不起⇒未下水" },
      "hint": "一张图 = 势力库里的一片叶（键 = 图名）。建造区只拿一个**指针**指向它，指针在「城市」页的建造区那一行改；图名是开放集合 ⇒ 这一行可以「＋ 新建」" }
  },
  "action_ui": {
    "buildings": { "label": "建筑", "editor": "building" }
  },
  "write_omit": [
    { "field": "invest_weights", "why": "随「建筑与建造区」行显示：每一片权重叶属于某个建造区，住在地点卡片的 building 行里（action: buildings）" },
    { "field": "build_weights", "why": "同上（建造区的建造权重）" }
  ],

