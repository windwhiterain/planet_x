          "id": "bp-table",
          "title": "各势力的设计图库",
          "mount": "panel",
          "layout": "table",
          "source": "@control[*]",
          "key": "faction_id",
          "select_kind": "faction",
          "columns": [
            { "path": "faction_id", "label": "势力", "click": "faction", "dot": "@state.factions[?势力=${faction_id}].颜色" },
            { "leaf": "@control[?faction_id=${faction_id}].blueprints", "new": true }
          ]
        }
      ]
    },
    {
      "id": "global",
      "title": "全局",
      "hint": "链上谁都没说话时按哪一档（全局作用域）。各层自己的表态在「未组织」页的 @scope 下也看得到",
      "views": [
        {
          "id": "global-scope",
          "title": "全局作用域",
          "mount": "panel",
          "layout": "sheet",
          "source": null,
          "columns": [
            { "owner": "global", "label": "全局默认归谁" },
            { "path": "@scope.factions", "label": "有表态的势力", "fmt": "pairs", "sep": "=" },
            { "path": "@scope.bodies", "label": "有表态的天体", "fmt": "pairs", "sep": "=" },
            { "path": "@scope.cities", "label": "有表态的城", "fmt": "pairs", "sep": "=" }
          ]
        }
      ]
    }

  ],
  "select": [
    {
      "id": "sel-ship",
      "title": "舰",
      "mount": "select",
      "select_kind": "ship",
      "layout": "sheet",
      "source": "@state.ships[*]",
      "key": "舰名",
      "columns": [
        { "path": "舰名", "label": "舰" },
        { "path": "势力", "dot": "@state.factions[?势力=${势力}].颜色" },
        { "path": "舰级", "fmt": "enum", "label_from": "config.ships" },
        { "path": "出厂图", "missing": "（无图，按舰级默认）" },
        { "path": "角色", "label": "角色（有效值）", "fmt": "enum", "map": { "War": "战舰", "Freight": "运输舰", "Observe": "观测舰" } },
        { "path": "船体", "with": "船体上限", "fmt": "ratio", "digits": 0 },
        { "path": "护盾", "with": "护盾上限", "fmt": "ratio", "digits": 0 },
        { "path": "风格", "label": "风格（有效值）", "fmt": "fields", "fields": [["temper", "理智↔热血"], ["lone_wolf", "护航↔独狼"]], "digits": 2 },
        { "path": "姿态", "label": "姿态（有效值，风筝↔贴脸）", "fmt": "num", "digits": 2 },
        { "leaf": "@control[?faction_id=${势力}].ship_orders[?ship=${舰名}]" },
        { "leaf": "@control[?faction_id=${势力}].ship_doctrine[?ship=${舰名}]" },
        { "leaf": "@control[?faction_id=${势力}].ship_kiting[?ship=${舰名}]" },
        { "leaf": "@control[?faction_id=${势力}].ship_role[?ship=${舰名}]" },
        { "path": "@control[?faction_id=${势力}].blueprints[?name=${出厂图}].mode", "label": "出厂图的归属", "fmt": "owner", "missing": "没有图", "map": { "Player": "玩家（图的话算数）", "Auto": "自动（图上的倾向只是流水）", "Inherit": "图没表态（沿作用域链上溯）" } },
        { "path": "@post.haul_steps.${舰名}.step", "label": "运输此刻", "fmt": "enum", "missing": "—", "map": { "loaded": "在装", "en_route": "在途", "waiting": "等货", "delivered": "已交货" } },
        { "path": "载货", "fmt": "map", "digits": 1, "missing": "空" },
        { "path": "坐标", "fmt": "vec", "digits": 1 },
        { "path": "速度", "fmt": "num", "digits": 2 },
        { "path": "下水回合", "fmt": "int" },
        { "path": "组件", "fmt": "list" }
      ]
    },
    {
      "id": "sel-city",
      "title": "城",
      "mount": "select",
      "select_kind": "city",
      "layout": "sheet",
      "source": "@state.cities[*]",
      "key": "城名",
      "columns": [
        { "path": "城名", "label": "城" },
        { "path": "势力", "dot": "@state.factions[?势力=${势力}].颜色" },
        { "path": "所在天体", "label": "天体" },
        { "path": "人口", "fmt": "int" },
        { "path": "忠诚度", "label": "忠诚", "fmt": "pct", "digits": 0, "bar": true },
        { "path": "@post.cities.${城名}.loyalty_target.effective", "label": "忠诚目标", "fmt": "pct", "digits": 0 },
        { "path": "@post.cities.${城名}.loyalty_target.distance", "label": "↳ 距离项", "fmt": "pct", "digits": 0 },
        { "path": "@post.cities.${城名}.loyalty_target.entertainment", "label": "↳ 娱乐项", "fmt": "pct", "digits": 0 },
        { "leaf": "@control[?faction_id=${势力}].loyalty_budget[?city=${城名}]" },
        { "path": "@post.cities.${城名}.labor", "label": "劳动力", "fmt": "pct", "digits": 0 },
        { "path": "@post.cities.${城名}.housing_capacity", "label": "住房容量", "fmt": "num", "digits": 0 },
        { "path": "@post.cities.${城名}.is_hub", "label": "集散枢纽", "fmt": "bool", "map": { "true": "是", "false": "否" } },
        { "path": "@post.cities.${城名}.production", "label": "产出/月", "fmt": "map", "digits": 1, "missing": "无产出" },
        { "path": "@post.cities.${城名}.production_value", "label": "产出价值", "fmt": "num", "digits": 1 },
        { "path": "@post.cities.${城名}.build", "label": "在造（进度/速率）", "fmt": "progress", "missing": "没在造" },
        { "action": "buildings", "label": "建筑与建造区" },
        { "path": "已焚毁", "fmt": "bool", "map": { "true": "⚠ 是", "false": "否" } },
        { "owner": "cities", "label": "这座城归谁" }
      ]
    },
    {
      "id": "sel-body",
      "title": "天体",
      "mount": "select",
      "select_kind": "body",
      "layout": "sheet",
      "source": "@state.bodies[*]",
      "key": "天体名",
      "columns": [
        { "path": "天体名", "label": "天体" },
        { "path": "类型", "fmt": "enum", "label_from": "config.body_kinds" },
        { "path": "轨道.母天体", "label": "母星", "missing": "（绕日）" },
        { "path": "位置", "label": "坐标", "fmt": "vec", "digits": 2 },
        { "path": "轨道.远日点距离", "label": "远日点 AU", "fmt": "num", "digits": 2 },
        { "path": "轨道.近日点距离", "label": "近日点 AU", "fmt": "num", "digits": 2 },
        { "path": "轨道.公转周期", "label": "公转（月）", "fmt": "num", "digits": 1 },
        { "path": "定居点[*].定居点", "label": "定居点", "fmt": "list" },
        { "path": "定居点", "label": "定居点明细", "fmt": "rows", "fields": ["total_area", "ecological_capacity", "construction_speed_mod"] },
        { "owner": "bodies", "label": "这个天体归谁" }
      ]
    },
    {
      "id": "sel-faction",
      "title": "势力",
      "mount": "select",
      "select_kind": "faction",
      "layout": "sheet",
      "source": "@state.factions[*]",
      "key": "势力",
      "columns": [
        { "path": "势力", "dot": "颜色" },
        { "path": "@post.power_share.${势力}", "label": "实力占比", "fmt": "pct", "digits": 0 },
        { "path": "@post.factions.${势力}.at_war", "label": "状态", "fmt": "bool", "map": { "true": "交战", "false": "和平" } },
        { "leaf": "@control[?faction_id=${势力}].capital" },
        { "path": "资源", "label": "首都库存", "fmt": "map", "digits": 0, "missing": "空" },
        { "path": "@post.factions.${势力}.production", "label": "产出/月", "fmt": "map", "digits": 1, "missing": "无产出" },
        { "path": "@post.factions.${势力}.production_value", "label": "产出价值", "fmt": "num", "digits": 1 },
        { "leaf": "@control[?faction_id=${势力}].investment_budget" },
        { "leaf": "@control[?faction_id=${势力}].construction_budget" },
        { "path": "@post.factions.${势力}.upkeep", "label": "舰队维护/月", "fmt": "num", "digits": 1 },
        { "path": "@post.factions.${势力}.upkeep_unpaid", "label": "没付上的维护", "fmt": "num", "digits": 1 },
        { "path": "@post.factions.${势力}.governance_cost", "label": "治理/月", "fmt": "num", "digits": 1 },
        { "path": "@post.factions.${势力}.governance_coverage", "label": "治理覆盖", "fmt": "pct", "digits": 0 },
        { "leaf": "@control[?faction_id=${势力}].loyalty_budget" },
        { "path": "@post.factions.${势力}.city_count", "label": "城", "fmt": "int" },
        { "path": "@post.factions.${势力}.ship_count", "label": "舰", "fmt": "int" },
        { "path": "@post.factions.${势力}.fleet_value", "label": "舰队", "fmt": "num", "digits": 0 },
        { "leaf": "@control[?faction_id=${势力}].default_role" },
        { "leaf": "@control[?faction_id=${势力}].default_doctrine" },
        { "leaf": "@control[?faction_id=${势力}].default_kiting" },
        { "path": "@post.factions.${势力}.purchasing_power", "label": "购买力", "fmt": "num", "digits": 0 },
        { "path": "@post.factions.${势力}.trade_blocked_by", "label": "被谁挡住贸易", "fmt": "map", "missing": "没人挡" },
        { "path": "@post.factions.${势力}.freight_gap", "label": "运力缺口", "fmt": "sum", "of": "uncovered", "digits": 1 },
        { "path": "MOND 掌握度", "label": "MOND 掌握度", "fmt": "pct", "digits": 0 },
        { "path": "名声", "fmt": "map", "digits": 0, "missing": "—" },
        { "path": "关系", "fmt": "map", "digits": 0, "missing": "—" },
        { "owner": "factions", "label": "这个势力归谁" }
      ]
    }
  ]
}
